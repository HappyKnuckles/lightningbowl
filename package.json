{
  "name": "lightning-bowl",
  "version": "0.1.0",
  "author": "Nicolas Hoffmann",
  "homepage": "https://github.com/HappyKnuckles/Lightning-Bowl",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:test": "ng build --configuration=test",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pretty": "npx prettier --write .",
    "prepare": "husky install || echo 'Skipping husky install'",
    "lint": "ng lint",
    "stylelint": "npx stylelint \"src/**/*.scss\"",
    "update:screenshots": "playwright test --config=playwright.config.ts",
    "update:screenshots:mobile": "playwright test --config=playwright.config.ts --project=mobile",
    "update:screenshots:desktop": "playwright test --config=playwright.config.ts --project=desktop",
    "update:screenshots:ui": "playwright test --config=playwright.config.ts --ui",
    "capture:fixtures": "playwright test --config=playwright.capture.config.ts playwright/screenshots/capture-fixtures.spec.ts --project=desktop",
    "e2e": "playwright test --config=playwright.e2e.config.ts",
    "e2e:ui": "playwright test --config=playwright.e2e.config.ts --ui",
    "e2e:headed": "playwright test --config=playwright.e2e.config.ts --headed",
    "e2e:report": "playwright show-report playwright/.e2e-report"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@angular/service-worker": "^20.3.18",
    "@capacitor-community/admob": "^6.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capawesome/capacitor-android-edge-to-edge-support": "^7.2.2",
    "@emailjs/browser": "^4.4.1",
    "@fontsource/material-icons": "^5.2.5",
    "@fontsource/roboto": "^5.2.6",
    "@ionic/angular": "^8.0.0",
    "@ionic/storage-angular": "^4.0.0",
    "@teamhive/lottie-player": "^1.0.0",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.2.0",
    "chart.js": "^4.4.2",
    "chartjs-plugin-zoom": "^2.2.0",
    "d3": "^7.9.0",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.0.0",
    "html-to-image": "^1.11.11",
    "ionicons": "^7.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "material-design-icons-iconfont": "^6.7.0",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.1",
    "tslib": "^2.3.0",
    "typeface-roboto": "^1.1.13",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.23",
    "@angular/cli": "^20.3.16",
    "@angular/compiler-cli": "^20.3.18",
    "@angular/language-service": "^20.3.18",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@ionic/angular-toolkit": "11.0.1",
    "@playwright/test": "^1.49.0",
    "@types/d3": "^7.4.3",
    "@types/events": "^3.0.3",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.18",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/node": "^22.5.4",
    "@types/sql.js": "^1.4.11",
    "@types/webxr": "^0.5.24",
    "angular-eslint": "19.1.0",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.4.3",
    "prettier": "3.5.2",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.58.0"
  },
  "description": "Lightning Bowl, a bowling score tracker.",
  "browserslist": [
    "Chrome >=120",
    "ChromeAndroid >=120",
    "Firefox >=121",
    "Edge >=120",
    "Safari >=17",
    "iOS >=17"
  ],
  "lint-staged": {
    "*.{js,ts,css,md,html}": "prettier --write",
    "*.ts": "eslint"
  }
}
